# FlamingPiston — URL redirects

# Canonical host — send www.flamingpiston.com to flamingpiston.com (Nov 2026)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.flamingpiston\.com$ [NC]
RewriteRule ^(.*)$ https://flamingpiston.com/$1 [R=301,L]

# Old flat review URLs → new folder-style URLs (SEO migration, Aug 2026)

Redirect 301 /reviews-toyota-hilux.html /reviews/toyota-hilux/
Redirect 301 /reviews-kia-syros-ev.html /reviews/kia-syros-ev/
Redirect 301 /reviews-maruti-brezza.html /reviews/2026-maruti-brezza-review/

# Homepage — force /index.html to the clean root URL
Redirect 301 /index.html /

# Consolidated duplicate article URLs (Sep 2026)
Redirect 301 /guides/maruti-brezza-maintenance-cost/ /reviews/2026-maruti-brezza-maintenance-cost/
Redirect 301 /reviews/2026-brezza-turbo-vs-petrol/ /reviews/2026-maruti-brezza-turbo-vs-petrol/
Redirect 301 /news-bmw-i5-lwb.html /news-bmw-i5-lwb-india.html

# Stale nested copy of the site — removed from the repo Nov 2026; redirect kept for old links
RedirectMatch 301 ^/site/(.*)$ /$1


# Internal project files that must never be served (Phase 2A, Nov 2026).
# Hostinger's Git deploy copies the whole repository, so these are blocked here. They return the
# normal 404 page. robots.txt and noindex are NOT access control; these rules are.
#   templates/ scripts/  working files (since Aug 2026)
#   docs/                internal documentation and design-reference screenshots
#   data/                homepage/catalogue source files (the pages embed what they need)
#   *.md                 CLAUDE.md, README.md, notes
#   *.py, *.sh, *.log    tooling
#   .git* and other dot-files
RedirectMatch 404 ^/(templates|scripts|docs|data)(/|$)
RedirectMatch 404 (?i)\.(md|markdown|py|sh|log)$
RedirectMatch 404 ^/\.(?!well-known/)

# Custom not-found page (redesign, Nov 2026)
ErrorDocument 404 /404.html
